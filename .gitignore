# Środowiska/zależności — odtwarzalne przez uruchom-panel.bat / npm install.
# WYJĄTEK: panel/docx/node_modules JEST wersjonowany (patrz niżej) — na
# niektórych firmowych sieciach dostęp do registry.npmjs.org jest zerwany
# na poziomie TLS (SSL inspection łamiąca handshake, ERR_SSL_PACKET_LENGTH_
# TOO_LONG) i `npm install` tam w ogóle nie zadziała. To tylko czysty JS
# (docx + małe transitive deps, bez skompilowanych binarek), więc jest w
# pełni przenośny między systemami — bezpieczniej dowieźć go razem z repo
# niż liczyć, że npm install się uda na docelowej maszynie.
generator-mapek/venv/
node_modules/
!panel/docx/node_modules/

# Cache generatorów (dane OSM, dogrywają się same przy pierwszym użyciu)
generator-mapek/cache/
Generaotr-mapy-skrzyzowania/cache/
Generaotr-mapy-skrzyzowania/region_cache/

# Wygenerowane pliki testowe/robocze
panel/docx/output/
__pycache__/
*.pyc
.pytest_cache/

# Dane robocze projektów użytkownika (per-projekt CSV/PNG/docx wygenerowane
# przez panel) — nie jest to kod, tylko dane wejściowe/wyjściowe użytkownika.
panel/ui/projekty/

# Foldery pomocnicze niebędące częścią repo
DoWindowska/

# Materiały historyczne/referencyjne spoza kodu panelu — nieużywane przez
# żadną aktywną ścieżkę kodu (patrz odpowiedź w sesji przy porządkowaniu
# eksportu na Windows).
/Archiwum.zip
/Sankey/
/dane-do-raportu/
/Raport_Torun_Orange_v3*.docx
/Orange_Polska-Logo.wine.png

# Lokalne ustawienia Claude Code (per-maszyna, nie część repo)
.claude/settings.local.json

# System
.DS_Store
